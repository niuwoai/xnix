# GENERATED by xnix-kde-image -- edit image/kinoite/manifest.json, not this file.
# Xnix KDE Plasma atomic image (Fedora Kinoite-compatible, bootc image mode).
FROM quay.io/fedora/fedora-kinoite:44

LABEL org.xnix.image="xnix-kinoite"
LABEL org.xnix.flagship="kde-plasma-6"

# --- Desktop, portal, and runtime support packages -----------------
RUN rpm-ostree install --idempotent \
        plasma-desktop \
        plasma-workspace \
        plasma-login-manager \
        plasma-systemsettings \
        dolphin \
        konsole \
        kde-gtk-config \
        plasma-nm \
        plasma-pa \
        kscreen \
        xdg-desktop-portal \
        xdg-desktop-portal-kde \
        glib2 \
        dbus

# --- Layered Xnix KDE entry-point artifacts ------------------------
COPY kde/dolphin/servicemenus/xnix-open-with-compatibility.desktop /usr/share/kio/servicemenus/xnix-open-with-compatibility.desktop
COPY kde/plasmoids/org.xnix.compatibilitycenter /usr/share/plasma/plasmoids/org.xnix.compatibilitycenter

# --- Image configuration overlays ----------------------------------
COPY image/kinoite/config/portal/xnix-portals.conf /usr/share/xdg-desktop-portal/xnix-portals.conf
COPY image/kinoite/config/os-release.d/xnix.conf /usr/lib/os-release.d/xnix.conf
COPY image/kinoite/config/systemd-preset/80-xnix.preset /usr/lib/systemd/system-preset/80-xnix.preset

# --- Presets: enable the graphical login ---------------------------
RUN systemctl preset-all

# bootc build validation keeps the ostree commit consistent.
RUN bootc container lint || true
