{
  "schema": "xnix.image.kinoite/v1",
  "image_name": "xnix-kinoite",
  "summary": "Fedora Kinoite-compatible atomic base with KDE Plasma 6 and staged Xnix desktop integration assets.",
  "base_image": "quay.io/fedora/fedora-kinoite:44",
  "architecture": "x86_64",
  "build_mode": "bootc-image",
  "desktop": {
    "environment": "kde-plasma-6",
    "session": "plasma",
    "session_type": "wayland",
    "display_manager": "plasmalogin",
    "compositor": "kwin-wayland"
  },
  "package_groups": {
    "plasma_desktop": [
      "plasma-desktop",
      "plasma-workspace",
      "plasma-login-manager",
      "plasma-systemsettings",
      "dolphin",
      "konsole",
      "kde-gtk-config",
      "plasma-nm",
      "plasma-pa",
      "kscreen"
    ],
    "xdg_portals": [
      "xdg-desktop-portal",
      "xdg-desktop-portal-kde"
    ],
    "xnix_runtime": [
      "glib2",
      "dbus"
    ]
  },
  "layered_artifacts": [
    {
      "id": "dolphin-service-menu",
      "source": "kde/dolphin/servicemenus/xnix-open-with-compatibility.desktop",
      "dest": "/usr/share/kio/servicemenus/xnix-open-with-compatibility.desktop",
      "role": "kde-entry-point"
    },
    {
      "id": "compatibility-center-plasmoid",
      "source": "kde/plasmoids/org.xnix.compatibilitycenter",
      "dest": "/usr/share/plasma/plasmoids/org.xnix.compatibilitycenter",
      "role": "kde-entry-point"
    }
  ],
  "config_overlays": [
    {
      "id": "portal-backend",
      "source": "image/kinoite/config/portal/xnix-portals.conf",
      "dest": "/usr/share/xdg-desktop-portal/xnix-portals.conf",
      "role": "portal-backend"
    },
    {
      "id": "os-branding",
      "source": "image/kinoite/config/os-release.d/xnix.conf",
      "dest": "/usr/lib/os-release.d/xnix.conf",
      "role": "branding"
    },
    {
      "id": "systemd-preset",
      "source": "image/kinoite/config/systemd-preset/80-xnix.preset",
      "dest": "/usr/lib/systemd/system-preset/80-xnix.preset",
      "role": "unit-preset"
    }
  ],
  "enabled_units": [
    "plasmalogin.service"
  ],
  "first_boot": {
    "target": "graphical.target",
    "greeter": "plasmalogin",
    "autologin": false
  },
  "kde_entry_points": [
    "compatibility-center",
    "krunner",
    "kwin",
    "dolphin",
    "system-tray",
    "notifications",
    "system-settings"
  ],
  "boot_smoke": {
    "expect_serial_markers": [
      "XNIX_BOOT_PROBE_PASS"
    ],
    "fail_marker": "XNIX_BOOT_PROBE_FAIL",
    "active_units": [
      "graphical.target",
      "plasmalogin.service"
    ],
    "timeout_seconds": 300
  },
  "provenance": {
    "runtime_owned": true,
    "kde_policy_owner": false,
    "host_root_modified": false,
    "privileged_build_required": true
  }
}
